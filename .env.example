APP_ENV=development
TZ=Europe/Amsterdam
DB_URL=sqlite:///data/live.sqlite3
RESULTS_ROOT=./artifacts/evaluations

EODHD_API_KEY=
FRED_API_KEY=
OPENEXCHANGERATES_APP_ID=
OPENEXCHANGE_API_KEY=

# Optional isolated-integration interpreter overrides.
VNPY_PYTHON=
QLIB_PYTHON=
FINRL_PYTHON=
MOONDEV_PYTHON=
NAUTILUS_PYTHON=

# Intelligence/RL/integration workers remain execution-neutral.
IBKR_READ_ONLY=true
LIVE_TRADING_ALLOWED=false
PAPER_TRADING_ALLOWED=true
WM_REAL_ORDER_EXECUTION_ENABLED=false
WM_I_UNDERSTAND_LIVE_RISK=false

MAX_GLOBAL_OPEN_RISK=0.06
MAX_GLOBAL_DRAWDOWN_SOFT=0.15
MAX_GLOBAL_DRAWDOWN_HARD=0.25
WM_ALLOCATOR_MAX_POSITIONS=5
WM_ALLOCATOR_MIN_POSITION_WEIGHT=0.05
WM_ALLOCATOR_MIN_POSITION_NOTIONAL=150
WM_ALLOCATOR_MAX_SINGLE_WEIGHT=0.35
WM_ALLOCATOR_MAX_STOCK_WEIGHT=0.85
WM_ALLOCATOR_MAX_ETF_WEIGHT=0.60
WM_ALLOCATOR_MAX_COMMODITY_WEIGHT=0.40
WM_ALLOCATOR_CASH_FLOOR=0.03
