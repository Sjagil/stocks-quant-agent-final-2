# Required market-data credential
EODHD_API_KEY=

# Optional context providers. Missing providers are reported and remain fail-closed.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
MARKETAUX_API_KEY=
CURRENTS_API_KEY=
FRED_API_KEY=

# IBKR TWS / Gateway. Port 7497 is the normal TWS paper port.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=41
IBKR_RECON_CLIENT_ID=42
IBKR_MARKET_DATA_CLIENT_ID=43
IBKR_ACCOUNT=
IBKR_ENVIRONMENT=PAPER
IBKR_ACCOUNT_BASE_CURRENCY=EUR

# Optional integrity key used by the imported read-only reconciliation adapter.
IBKR_ACCOUNT_FINGERPRINT_KEY=
